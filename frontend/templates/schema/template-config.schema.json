{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloud-legal-stenographer:template-config:1.0",
  "title": "Cloud Legal Stenographer Template Configuration 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "example",
        "reviewed"
      ]
    },
    "review_note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
          "maxLength": 40
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "enum": [
                "A4",
                "Letter"
              ]
            },
            "orientation": {
              "enum": [
                "portrait",
                "landscape"
              ]
            },
            "margins_mm": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 50
                },
                "right": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 50
                },
                "bottom": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 50
                },
                "left": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 50
                }
              },
              "required": [
                "top",
                "right",
                "bottom",
                "left"
              ]
            }
          },
          "required": [
            "size",
            "orientation",
            "margins_mm"
          ]
        },
        "font_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "font_size_pt": {
          "type": "number",
          "minimum": 8,
          "maximum": 24
        },
        "line_height": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "paragraph_space_after_pt": {
          "type": "number",
          "minimum": 0,
          "maximum": 36
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/heading"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "repeat"
                  },
                  "section": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,47}$"
                  },
                  "blocks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "$ref": "#/$defs/paragraph"
                    }
                  }
                },
                "required": [
                  "type",
                  "section",
                  "blocks"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "table"
                  },
                  "section": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,47}$"
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        },
                        "text": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 20000
                        },
                        "width_percent": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "label",
                        "text",
                        "width_percent"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "section",
                  "columns"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "language",
        "direction",
        "page",
        "font_family",
        "font_size_pt",
        "line_height",
        "paragraph_space_after_pt",
        "blocks"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docx_filename_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transcript_filename_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "print_title_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "docx_filename_pattern",
        "transcript_filename_pattern",
        "print_title_pattern"
      ]
    }
  },
  "required": [
